diff --git a/src/web/server.mjs b/src/web/server.mjs
index 0244bb1..7f423b1 100755
--- a/src/web/server.mjs
+++ b/src/web/server.mjs
@@ -8,6 +8,7 @@
 //
 // Routes (every API response is a JSON envelope {success, ...}; fail-closed):
 //   GET  /                    -> interfaces/operator-console.html (text/html)
+//   GET  /start-here          -> interfaces/start-here.html (text/html) — START_HERE.md UI
 //   GET  /api/status          -> boot-shape record + nodeCount from the manifest
 //   GET  /api/repos           -> { nodes, validation } against the vault root
 //   GET  /api/repos/<name>    -> single manifest node or 404 {success:false}
@@ -270,6 +271,15 @@ function serveConsole() {
   return { body: fs.readFileSync(consolePath), contentType: 'text/html; charset=utf-8' };
 }
 
+/** @returns {{body: Buffer, contentType: string}} START_HERE.md as a zero-dep HTML surface */
+function serveStartHere() {
+  const startPath = safeJoin('interfaces', 'start-here.html');
+  if (!fs.existsSync(startPath)) {
+    throw new Error(`start-here UI missing at ${startPath}`);
+  }
+  return { body: fs.readFileSync(startPath), contentType: 'text/html; charset=utf-8' };
+}
+
 /**
  * @param {import('node:http').ServerResponse} res
  * @param {number} status
@@ -359,8 +369,20 @@ async function handle(req, res) {
       return;
     }
 
+    if (req.method === 'GET' && segments.length === 1 && segments[0] === 'start-here') {
+      const { body, contentType } = serveStartHere();
+      res.writeHead(200, {
+        'content-type': contentType,
+        'content-length': Buffer.byteLength(body),
+        'cache-control': 'no-store',
+        'x-content-type-options': 'nosniff',
+      });
+      res.end(body);
+      return;
+    }
+
     if (segments[0] !== 'api') {
-      sendJson(res, 404, fail(`not found: ${req.method} ${route.pathname} (operator console at /, API under /api/)`));
+      sendJson(res, 404, fail(`not found: ${req.method} ${route.pathname} (operator console at /, start-here at /start-here, API under /api/)`));
       return;
     }
 
